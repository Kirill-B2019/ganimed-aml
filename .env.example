APP_NAME="GANIMED AML"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
DEBUGBAR_ENABLED=true
APP_URL=http://127.0.0.1:8088
SERVER_PORT=8088

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Europe/Moscow

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aml_gnd
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOPLUS_BASE_URL=https://api.gopluslabs.io
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=
GOPLUS_TIMEOUT=30

TRONGRID_BASE_URL=https://api.trongrid.io
TRONGRID_API_KEY=
# Same key is sent to Tronscan (TRON-PRO-API-KEY) for token contract status.
TRONSCAN_BASE_URL=https://apilist.tronscanapi.com
ONCHAIN_MIN_INTERVAL_MS=1300
ONCHAIN_ACCOUNT_CACHE=900
ONCHAIN_GRAPH_NEIGHBOR_CAP=12
ONCHAIN_GRAPH_HOP2_SEEDS=4
ONCHAIN_GRAPH_MAX_NODES=20
ONCHAIN_FINGERPRINT_PAGES=2
ONCHAIN_RETRY_ATTEMPTS=3
ONCHAIN_RETRY_MS=5500

REPORT_FOOTER="https://main-node.gnd-net.com/ | KB @CerberRus00 - Nexus Invest Team"

ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=ChangeMe123!

WWWUSER=1000
WWWGROUP=1000
APP_PORT=80
FORWARD_DB_PORT=3306
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
